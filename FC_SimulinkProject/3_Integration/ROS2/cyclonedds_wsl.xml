<CycloneDDS>
  <!-- WSL2 NAT DDS 跨界最小配置
       关键：禁用 shared memory，只走 UDP。WSL2 不同会话间 shared memory 不互通。
       eth0 上的 UDP multicast 对同机所有 WSL 会话 + Windows 侧均可达。
  -->
  <Domain>
    <SharedMemory>
      <Enable>false</Enable>
    </SharedMemory>
    <General>
      <Interfaces>
        <NetworkInterface name="eth0"/>
      </Interfaces>
      <AllowMulticast>true</AllowMulticast>
    </General>
  </Domain>
</CycloneDDS>
