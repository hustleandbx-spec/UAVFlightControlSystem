{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uavsingle.local/schemas/aircraft_udp_environment_v1.schema.json",
  "title": "Aircraft UDP Environment Packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "packet_type",
    "timestamp",
    "sequence",
    "wind_ned_mps"
  ],
  "properties": {
    "protocol_version": { "const": 1 },
    "packet_type": { "const": "environment" },
    "timestamp": { "type": "number" },
    "sequence": { "type": "integer", "minimum": 0 },
    "source_id": { "type": "integer", "minimum": 0, "default": 0 },
    "wind_ned_mps": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "source_policy": { "enum": ["configured", "unknown"], "default": "configured" }
  }
}
