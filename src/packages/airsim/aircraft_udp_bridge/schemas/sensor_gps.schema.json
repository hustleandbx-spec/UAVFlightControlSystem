{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uavsingle.local/schemas/aircraft_udp_sensor_gps_v1.schema.json",
  "title": "Aircraft UDP Sensor GPS Packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "packet_type",
    "timestamp",
    "sequence",
    "geo_point",
    "velocity",
    "is_valid"
  ],
  "properties": {
    "protocol_version": { "const": 1 },
    "packet_type": { "const": "sensor_gps" },
    "timestamp": { "type": "number" },
    "sequence": { "type": "integer", "minimum": 0 },
    "source_id": { "type": "integer", "minimum": 0, "default": 0 },
    "geo_point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latitude", "longitude", "altitude"],
      "properties": {
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "altitude": { "type": "number" }
      }
    },
    "velocity": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "eph": { "type": "number" },
    "epv": { "type": "number" },
    "fix_type": { "type": "integer", "minimum": 0, "maximum": 3 },
    "time_utc": { "type": "integer", "minimum": 0 },
    "is_valid": { "type": "boolean" }
  }
}
