{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uavsingle.local/schemas/aircraft_udp_motor_state_v1.schema.json",
  "title": "Aircraft UDP Motor State Packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "packet_type",
    "timestamp",
    "sequence",
    "rotors"
  ],
  "properties": {
    "protocol_version": { "const": 1 },
    "packet_type": { "const": "motor_state" },
    "timestamp": { "type": "number" },
    "sequence": { "type": "integer", "minimum": 0 },
    "source_id": { "type": "integer", "minimum": 0, "default": 0 },
    "native_timestamp": { "type": "integer", "minimum": 0 },
    "rotors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["thrust", "torque_scaler", "speed"],
        "properties": {
          "thrust": { "type": "number" },
          "torque_scaler": { "type": "number" },
          "speed": { "type": "number" }
        }
      }
    }
  }
}
