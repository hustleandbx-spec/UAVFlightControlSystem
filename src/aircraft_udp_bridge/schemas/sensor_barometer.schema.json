{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uavsingle.local/schemas/aircraft_udp_sensor_barometer_v1.schema.json",
  "title": "Aircraft UDP Sensor Barometer Packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "packet_type",
    "timestamp",
    "sequence",
    "altitude",
    "pressure",
    "qnh"
  ],
  "properties": {
    "protocol_version": { "const": 1 },
    "packet_type": { "const": "sensor_barometer" },
    "timestamp": { "type": "number" },
    "sequence": { "type": "integer", "minimum": 0 },
    "source_id": { "type": "integer", "minimum": 0, "default": 0 },
    "altitude": { "type": "number" },
    "pressure": { "type": "number" },
    "qnh": { "type": "number" }
  }
}
