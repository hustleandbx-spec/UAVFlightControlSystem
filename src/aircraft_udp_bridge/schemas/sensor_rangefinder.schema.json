{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uavsingle.local/schemas/aircraft_udp_sensor_rangefinder_v1.schema.json",
  "title": "Aircraft UDP Sensor Rangefinder Packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "packet_type",
    "timestamp",
    "sequence",
    "distance",
    "min_distance",
    "max_distance"
  ],
  "properties": {
    "protocol_version": { "const": 1 },
    "packet_type": { "const": "sensor_rangefinder" },
    "timestamp": { "type": "number" },
    "sequence": { "type": "integer", "minimum": 0 },
    "source_id": { "type": "integer", "minimum": 0, "default": 0 },
    "frame_id": { "type": "string" },
    "distance": { "type": "number" },
    "min_distance": { "type": "number" },
    "max_distance": { "type": "number" },
    "relative_pose": { "$ref": "#/$defs/pose" }
  },
  "$defs": {
    "pose": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "orientation"],
      "properties": {
        "position": {
          "type": "array",
          "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "orientation": {
          "type": "array",
          "prefixItems": [
            { "type": "number" },
            { "type": "number" },
            { "type": "number" },
            { "type": "number" }
          ],
          "items": false,
          "minItems": 4,
          "maxItems": 4
        }
      }
    }
  }
}
