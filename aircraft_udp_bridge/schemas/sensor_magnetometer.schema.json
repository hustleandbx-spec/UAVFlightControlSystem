{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uavsingle.local/schemas/aircraft_udp_sensor_magnetometer_v1.schema.json",
  "title": "Aircraft UDP Sensor Magnetometer Packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "packet_type",
    "timestamp",
    "sequence",
    "magnetic_field_body"
  ],
  "properties": {
    "protocol_version": { "const": 1 },
    "packet_type": { "const": "sensor_magnetometer" },
    "timestamp": { "type": "number" },
    "sequence": { "type": "integer", "minimum": 0 },
    "source_id": { "type": "integer", "minimum": 0, "default": 0 },
    "frame_id": { "type": "string", "default": "aircraft_frd" },
    "magnetic_field_body": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "magnetic_field_covariance": {
      "type": "array",
      "prefixItems": [
        { "type": "number" },
        { "type": "number" },
        { "type": "number" },
        { "type": "number" },
        { "type": "number" },
        { "type": "number" },
        { "type": "number" },
        { "type": "number" },
        { "type": "number" }
      ],
      "items": false,
      "minItems": 9,
      "maxItems": 9
    }
  }
}
