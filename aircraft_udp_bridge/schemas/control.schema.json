{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uavsingle.local/schemas/aircraft_udp_control_v1.schema.json",
  "title": "Aircraft UDP Control Packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "packet_type",
    "timestamp",
    "sequence",
    "mode",
    "throttle",
    "roll",
    "pitch",
    "yaw"
  ],
  "properties": {
    "protocol_version": { "const": 1 },
    "packet_type": { "const": "control" },
    "timestamp": { "type": "number" },
    "sequence": { "type": "integer", "minimum": 0 },
    "mode": { "enum": ["rate", "attitude"] },
    "throttle": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "roll": { "type": "number" },
    "pitch": { "type": "number" },
    "yaw": { "type": "number" }
  }
}
