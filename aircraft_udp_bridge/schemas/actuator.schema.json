{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uavsingle.local/schemas/aircraft_udp_actuator_v1.schema.json",
  "title": "Aircraft UDP Actuator Packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "packet_type",
    "timestamp",
    "sequence",
    "mode",
    "motor_cmd"
  ],
  "properties": {
    "protocol_version": { "const": 1 },
    "packet_type": { "const": "actuator" },
    "timestamp": { "type": "number" },
    "sequence": { "type": "integer", "minimum": 0 },
    "mode": { "const": "motor" },
    "motor_cmd": {
      "type": "array",
      "prefixItems": [
        { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        { "type": "number", "minimum": 0.0, "maximum": 1.0 }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    }
  }
}
